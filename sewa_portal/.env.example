# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# For local development, leave DATABASE_URL empty to use SQLite
# For production (PostgreSQL), set: postgresql://user:password@host:port/dbname
DATABASE_URL=

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Sewa Portal <your-email@gmail.com>

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend-domain.com

# Dropbox Storage Configuration
USE_DROPBOX=True
DROPBOX_ACCESS_TOKEN=your-dropbox-access-token-here
DROPBOX_ROOT_PATH=/sewa_portal
DROPBOX_TIMEOUT=100

# JWT Token Configuration (in seconds)
# Note: Configure in settings.py using timedelta
# ACCESS_TOKEN_LIFETIME=1800  # 30 minutes
# REFRESH_TOKEN_LIFETIME=604800  # 7 days
